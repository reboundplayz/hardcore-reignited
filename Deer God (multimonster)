        or "https://github.com/reboundplayz/Doors-Fixed-Modes/raw/refs/heads/main/Your_Consenting_Mind.ogg"
        
    local fileName = isDead 
        and "deergodambient_clean.mp3" 
        or "deergodambient_fixed.ogg"
    
    ambientSound = Instance.new("Sound")
    ambientSound.Name = "DeerGodAmbientMusic"
    ambientSound.Volume = 2.5
    ambientSound.Looped = true
    ambientSound.Parent = game:GetService("SoundService")

    pcall(function()
        DownloadFile(fileName, url)
        if getasset then
