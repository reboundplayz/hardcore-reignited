local function StopSubtitleLoop()
    subtitleLoopRunning = false
    print("[Deer God UI Debug] Stopping Subtitle Loop.")
    if customCaptionLabel then
        TweenService:Create(customCaptionLabel, TweenInfo.new(0.3), {TextTransparency = 1, TextStrokeTransparency = 1}):Play()
    end
end

-- File Downloader Helper
local function DownloadFile(fileName, url)
    if not isfile(fileName) then
