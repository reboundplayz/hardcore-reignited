                        end
                    end
                end
            end
        end)

        local tweenInfo = TweenInfo.new(22, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
        local cutsceneTween = TweenService:Create(progress, tweenInfo, {Value = 1})

        cutsceneTween:Play()
        task.wait(9.6)

        if cameraConnection then
            cameraConnection:Disconnect()
        end
        Jumpscare:Destroy()

        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.Health = 0
        end
        
        local sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://4988621968"
        sound.Volume = 10
        sound.PlaybackSpeed = 0.6
        sound.Parent = workspace
        sound:Play()

        camera.CameraType = Enum.CameraType.Custom

        if cutsceneLight then cutsceneLight:Destroy() end
        if redTint then redTint:Destroy() end
        if atmosphereGlow then atmosphereGlow:Destroy() end
        if spawnedModel then spawnedModel:Destroy() end
        if progress then progress:Destroy() end
        if DeerGod then DeerGod:Destroy() end

        print("Cutscene finished and successfully cleaned up!")
    end)
end

-- Helper function for smooth physical chase loop
local function StartChase()
    if isEnraged or cutscenePlaying or not activeEntityModel or IsPlayerDeadOrSpectating() then return end
    isEnraged = true
    
    for _, part in ipairs(activeEntityModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end

    local chaseConnection
    chaseConnection = RunService.RenderStepped:Connect(function(deltaTime)
        local currentChar = LocalPlayer.Character
        if activeEntityModel and activeEntityModel.Parent and currentChar and currentChar:FindFirstChild("HumanoidRootPart") and not cutscenePlaying and not IsPlayerDeadOrSpectating() then
            local pRoot = currentChar.HumanoidRootPart
            local currentPivot = activeEntityModel:GetPivot()
            
            local targetLook = Vector3.new(pRoot.Position.X, currentPivot.Position.Y, pRoot.Position.Z)
            local direction = (pRoot.Position - currentPivot.Position).Unit
            
            local moveSpeed = 40 
            local nextPosition = currentPivot.Position + (direction * (moveSpeed * deltaTime))
            
            activeEntityModel:PivotTo(CFrame.new(nextPosition, targetLook))
            
            local distance = (pRoot.Position - currentPivot.Position).Magnitude
            if distance <= 6.5 then
                chaseConnection:Disconnect()
                task.spawn(PlayCustomCutscene)
            end
        else
            chaseConnection:Disconnect()
        end
    end)
end

