        atmosphereGlow.Decay = Color3.fromRGB(180, 0, 0)
        atmosphereGlow.Glare = 100 
        atmosphereGlow.Density = 0.86 
        atmosphereGlow.Parent = Lighting

        local PlayerGui = game.Players.LocalPlayer.PlayerGui

        local DeerGod = Instance.new("ScreenGui")
        DeerGod.Name = "DeerGodFace"
        DeerGod.IgnoreGuiInset = true
        DeerGod.ClipToDeviceSafeArea = false
        DeerGod.DisplayOrder = 999
        DeerGod.Parent = PlayerGui

        local flashBg = Instance.new("Frame")
        flashBg.Size = UDim2.new(1, 0, 1, 0)
        flashBg.BackgroundColor3 = Color3.new(0, 0, 0)
        flashBg.BackgroundTransparency = 1
        flashBg.BorderSizePixel = 0
        flashBg.ZIndex = 1
        flashBg.Parent = DeerGod

        local flashter = Instance.new("ImageLabel")
        flashter.AnchorPoint = Vector2.new(0.5, 0.5)
        flashter.Position = UDim2.new(0.5, 0, 0.5, 0)
        flashter.Size = UDim2.new(1.3, 0, 1.3, 0)
        flashter.BackgroundTransparency = 1
        flashter.Image = "rbxassetid://129191734706359"
        flashter.ImageTransparency = 1
        flashter.ScaleType = Enum.ScaleType.Fit
        flashter.ZIndex = 2
        flashter.Parent = DeerGod

        local function flashImage(duration, times)
            local delayTime = duration / (times * 2)
            for i = 1, times do
                flashter.ImageTransparency = 0
                flashBg.BackgroundTransparency = 0
                flashBg.BackgroundColor3 = Color3.new(1, 1, 1)
                task.wait(delayTime)

                flashBg.BackgroundColor3 = Color3.new(0, 0, 0)
                task.wait(delayTime)
            end
            flashter.ImageTransparency = 1
            flashBg.BackgroundTransparency = 1
        end

        task.spawn(function()
            task.wait(2)
            flashImage(0.4, 6)
            task.wait(4)
            flashImage(0.4, 6)
            task.wait(0.5)
            flashImage(0.4, 6)
            task.wait(0.5)
            flashImage(0.5, 8)
            task.wait(0.5)
        end)

        local cameraConnection
        cameraConnection = RunService.RenderStepped:Connect(function()
            camera.CameraType = Enum.CameraType.Scriptable

            local currentPos = startPos:Lerp(targetPos, progress.Value)

            camera.CFrame = CFrame.lookAt(currentPos, targetPos)

            for _, obj in ipairs(Workspace:GetChildren()) do
                if obj.Name == "wmetjkn_cutscene_root" or obj.Name == "Model" or obj.Name == "DeathForest" or obj:FindFirstChild("Deer God", true) then
                    for _, part in ipairs(obj:GetDescendants()) do
                        if part:IsA("BasePart") and not part.Anchored then
                            part.Anchored = true
