local function SetupDeerGodCaption()
    if customCaptionLabel and customCaptionLabel.Parent then 
        print("[Deer God UI Debug] Caption UI already initialized.")
        return true 
    end

    print("[Deer God UI Debug] Attempting to setup Caption UI...")
    
    local mainUI = PlayerGui:FindFirstChild("MainUI")
    if not mainUI then
        print("[Deer God UI Debug] MainUI not found immediately, waiting...")
        mainUI = PlayerGui:WaitForChild("MainUI", 2)
    end

    local originalCaption = nil
    if mainUI then
        print("[Deer God UI Debug] MainUI found!")
        local mainFrame = mainUI:FindFirstChild("MainFrame")
        if mainFrame then
            originalCaption = mainFrame:FindFirstChild("Caption")
        end
    else
        print("[Deer God UI Debug] WARNING: MainUI was not found in PlayerGui.")
    end

    -- Attempt 1: Clone Native DOORS Caption
    if originalCaption then
        print("[Deer God UI Debug] SUCCESS: Original Caption frame found in MainFrame! Cloning now...")
        local success, err = pcall(function()
            customCaptionLabel = originalCaption:Clone()
            customCaptionLabel.Name = "DeerGodCaption"
            ApplyCustomFont(customCaptionLabel)
            customCaptionLabel.TextColor3 = Color3.fromRGB(150, 40, 220) -- Purple Accent
            customCaptionLabel.TextTransparency = 1
            customCaptionLabel.TextStrokeTransparency = 1
            customCaptionLabel.Visible = true
            customCaptionLabel.Parent = originalCaption.Parent
        end)

        if success and customCaptionLabel then
            print("[Deer God UI Debug] Cloned native caption successfully!")
            return true
        else
            warn("[Deer God UI Debug] Failed to clone original caption: " .. tostring(err))
        end
    else
        print("[Deer God UI Debug] Could not find original Caption frame in MainUI.")
    end

    -- Attempt 2: Standalone Custom ScreenGui Fallback
    print("[Deer God UI Debug] Creating standalone ScreenGui fallback for caption...")
    local success, err = pcall(function()
        fallbackScreenGui = Instance.new("ScreenGui")
        fallbackScreenGui.Name = "DeerGodFallbackGui"
        fallbackScreenGui.ResetOnSpawn = false
        fallbackScreenGui.IgnoreGuiInset = true
        fallbackScreenGui.DisplayOrder = 9999 -- Force on top of everything
        fallbackScreenGui.Parent = PlayerGui

        local label = Instance.new("TextLabel")
        label.Name = "DeerGodCaptionFallback"
        label.Size = UDim2.new(0.8, 0, 0.1, 0)
        label.Position = UDim2.new(0.5, 0, 0.82, 0)
        label.AnchorPoint = Vector2.new(0.5, 0.5)
        label.BackgroundTransparency = 1
        ApplyCustomFont(label)
        label.TextColor3 = Color3.fromRGB(150, 40, 220)
        label.TextScaled = true
        label.TextWrapped = true
        label.TextTransparency = 1
        label.TextStrokeTransparency = 1
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Parent = fallbackScreenGui

        customCaptionLabel = label
    end)

    if success and customCaptionLabel then
        print("[Deer God UI Debug] Standalone caption fallback created successfully!")
        return true
    else
        warn("[Deer God UI Debug] Critical failure creating fallback GUI: " .. tostring(err))
        return false
    end
end

local function DisplayDeerGodCaption(textToDisplay)
    task.spawn(function()
        print("[Deer God UI Debug] Displaying caption: '" .. tostring(textToDisplay) .. "'")
        
        local ready = SetupDeerGodCaption()
        if not ready or not customCaptionLabel then
            warn("[Deer God UI Debug] Cannot display caption — customCaptionLabel is nil!")
            return
        end

        customCaptionLabel.Text = textToDisplay
        
        -- Fade in
        local tweenIn = TweenService:Create(customCaptionLabel, TweenInfo.new(0.5), {TextTransparency = 0, TextStrokeTransparency = 0.4})
        tweenIn:Play()
        tweenIn.Completed:Wait()
        print("[Deer God UI Debug] Fade-in complete for caption.")

        -- Hold display
        task.wait(4)

        -- Fade out
        local tweenOut = TweenService:Create(customCaptionLabel, TweenInfo.new(0.5), {TextTransparency = 1, TextStrokeTransparency = 1})
        tweenOut:Play()
        tweenOut.Completed:Wait()
        print("[Deer God UI Debug] Fade-out complete for caption.")
    end)
end

local function StartSubtitleLoop()
    subtitleLoopRunning = true
