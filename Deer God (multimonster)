            if entity and entity.Debug and entity.Debug.Model then
                activeEntityModel = entity.Debug.Model
            end
            if not activeEntityModel then
                for _, child in ipairs(workspace:GetChildren()) do
                    if child:IsA("Model") and (child.Name == "Deer God" or child:FindFirstChild("DeerLord 2", true)) then
                        activeEntityModel = child
                        break
                    end
                end
            end
            if not activeEntityModel then
                local spawnerFolder = workspace:FindFirstChild("Spawner_Entities")
                if spawnerFolder then
                    for _, child in ipairs(spawnerFolder:GetChildren()) do
                        if child:IsA("Model") and (child.Name == "Deer God" or child:FindFirstChild("DeerLord 2", true)) then
                            activeEntityModel = child
                            break
                        end
                    end
                end
            end
            task.wait(0.05)
        end
        print("Model reference captured smoothly!")
    end)

    -- Look Detection Loop
    task.spawn(function()
        while task.wait(0.05) do
            if cutscenePlaying or isEnraged or IsPlayerDeadOrSpectating() then break end
            
            local character = LocalPlayer.Character
            if activeEntityModel and character and character:FindFirstChild("HumanoidRootPart") then
                local entityPart = activeEntityModel:FindFirstChild("HumanoidRootPart") or activeEntityModel:FindFirstChildWhichIsA("BasePart", true)
                
                if entityPart then
                    local camera = workspace.CurrentCamera
                    local _, onScreen = camera:WorldToViewportPoint(entityPart.Position)
                    
                    if onScreen then
                        local camLook = camera.CFrame.LookVector
                        local toEntity = (entityPart.Position - camera.CFrame.Position).Unit
                        local dotProduct = camLook:Dot(toEntity)
                        
                        if dotProduct > 0.60 then 
                            local raycastParams = RaycastParams.new()
                            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                            raycastParams.FilterDescendantsInstances = {character, activeEntityModel, camera}
                            raycastParams.IgnoreWater = true
                            
                            local rayOrigin = camera.CFrame.Position
                            local rayDirection = entityPart.Position - rayOrigin
                            local raycastResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
                            
                            if not raycastResult then
                                print("Player looked directly at Deer God with clear Line of Sight!")
                                StartChase()
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
end)

