-- Custom Cutscene System
local function PlayCustomCutscene()
    if cutscenePlaying then return end
    cutscenePlaying = true

    StopSubtitleLoop()
    RemoveStaticEffect()
    StopConstantFlicker() 
    StopAmbientSound()

    task.spawn(function()
        local Workspace = game:GetService("Workspace")
        local Lighting = game:GetService("Lighting")
        local RunService = game:GetService("RunService")
        local TweenService = game:GetService("TweenService")
        local Players = game:GetService("Players")

        local camera = Workspace.CurrentCamera
        local localPlayer = Players.LocalPlayer
        
        local function getgithubmodeL(url)
            if not (writefile and getcustomasset and request) then return nil end
            local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"
            local response = request({Url = url, Method = "GET"})
            if not response or response.StatusCode ~= 200 then return nil end
            writefile(fileName, response.Body)
            local assetId = (getcustomasset or getsynasset)(fileName)
            local success, result = pcall(function() return game:GetObjects(assetId)[1] end)
            return success and result or nil
        end

        local function GetGitSound(GithubSnd, SoundName)
            local url = GithubSnd
            if not isfile(SoundName .. ".oga") then
                writefile(SoundName .. ".oga", game:HttpGet(url))
            end
            local sound = Instance.new("Sound")
            sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".oga")
            return sound
        end
        local Jumpscare = GetGitSound("https://github.com/eoyoustme/Hardcore/blob/main/DL_AMB.oga?raw=true","DL")
        Jumpscare.Parent = workspace
        Jumpscare.Volume = 3
        Jumpscare.PlaybackSpeed = 1
        Jumpscare:Play()

        local modelUrl = "https://github.com/reboundplayz/hardcore-reignited/raw/refs/heads/main/deerjsfix.rbxm"
        local modelFile = "Deerjsfix.rbxm"
        local CUTSCENE_DURATION = 9.6

        for _, oldObj in ipairs(Workspace:GetChildren()) do
            if oldObj.Name == "ashj_cutscene_root" or oldObj.Name == "Model" or oldObj.Name == "DeathForest" then
                if oldObj:FindFirstChild("Deer God", true) or oldObj:FindFirstChild("Back", true) then
                    oldObj:Destroy()
                end
            end
        end

        local spawnedModel = nil
        pcall(function()
            spawnedModel = getgithubmodeL(modelUrl)
        end)

        if not spawnedModel then 
            warn("Failed to load custom cutscene model asset.")
            return 
        end

        spawnedModel.Name = "DeathForest"

        local spawnLocation = CFrame.new(0, -1000, 0)
        spawnedModel.Parent = Workspace
        if spawnedModel:IsA("Model") then
            spawnedModel:PivotTo(spawnLocation)
        elseif spawnedModel:IsA("BasePart") then
            spawnedModel.CFrame = spawnLocation
        end

        local backPart = spawnedModel:FindFirstChild("Camera", true)
        local targetPart = spawnedModel:FindFirstChild("Deer God", true)

        local baseStartPos = (backPart and backPart:IsA("BasePart") and backPart.Position) or spawnedModel:GetPivot().Position
        local baseTargetPos = (targetPart and targetPart:IsA("BasePart") and targetPart.Position) or spawnedModel:GetPivot().Position

        local startPos = baseStartPos - Vector3.new(1, -1, 0)
        local targetPos = baseTargetPos - Vector3.new(2, -2, 0)

        local progress = Instance.new("NumberValue")
        progress.Value = 0

        local cutsceneLight = Instance.new("PointLight")
        cutsceneLight.Name = "CutsceneIllumination"
        cutsceneLight.Color = Color3.fromRGB(255, 10, 10)
        cutsceneLight.Range = 150 
        cutsceneLight.Brightness = 35 
        cutsceneLight.Shadows = false
        cutsceneLight.Parent = camera 

        local redTint = Instance.new("ColorCorrectionEffect")
        redTint.Name = "CutsceneRedTint"
        redTint.TintColor = Color3.fromRGB(255, 30, 30)
        redTint.Brightness = 0.25
        redTint.Contrast = 0.2
        redTint.Parent = Lighting

        local atmosphereGlow = Instance.new("Atmosphere")
