-- Helper: Reliable Warmth Detection
local function IsPlayerWarm(character)
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    -- 1. Check equipped item (Lighter / Torch / Light source tools)
    local tool = character:FindFirstChildOfClass("Tool")
    if tool then
        if tool:GetAttribute("Enabled") == true or tool:GetAttribute("IsOn") == true or tool:GetAttribute("TurnedOn") == true then
            return true
        end

        for _, desc in ipairs(tool:GetDescendants()) do
            if desc:IsA("Light") and desc.Enabled then
                return true
            elseif desc:IsA("ParticleEmitter") and desc.Enabled and (desc.Name:lower():find("fire") or desc.Name:lower():find("flame") or desc.Name:lower():find("spark")) then
                return true
            elseif desc:IsA("Fire") and desc.Enabled then
                return true
            end
        end
    end

    -- 2. Check nearby room light sources, fireplaces, or candles in Workspace
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local filterList = {character}
    local entityModel = workspace:FindFirstChild("Frostyma5n")
    if entityModel then table.insert(filterList, entityModel) end
    overlapParams.FilterDescendantsInstances = filterList

    local nearbyParts = workspace:GetPartBoundsInRadius(root.Position, 15, overlapParams)
    for _, part in ipairs(nearbyParts) do
        if part:IsDescendantOf(entityModel) then continue end

        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("Light") and child.Enabled then
                return true
            elseif child:IsA("Fire") and child.Enabled then
                return true
            elseif child:IsA("ParticleEmitter") and child.Enabled and (child.Name:lower():find("fire") or child.Name:lower():find("flame")) then
                return true
            end
        end

        local parent = part.Parent
        if parent then
            local pName = parent.Name:lower()
            if pName:find("fireplace") or pName:find("campfire") or pName:find("light") or pName:find("lamp") or pName:find("candle") or pName:find("heater") then
                return true
            end
        end
    end

    return false
end

