local hasTriggered = false
local destroyedRooms = {}

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if room and not destroyedRooms[room] then
        destroyedRooms[room] = true

        task.spawn(function()
            task.wait(0.05)

            local breakSound = Instance.new("Sound")
            breakSound.SoundId = "rbxassetid://9114223171"
            breakSound.Volume = 2.5
            breakSound.Parent = room:FindFirstChild("Assets") or room
            breakSound:Play()
            breakSound.Ended:Connect(function() breakSound:Destroy() end)

            local assetContainer = room:FindFirstChild("Assets") or room
            local breakSounds = {
                "rbxassetid://9125992545",
                "rbxassetid://4004052860",
                "rbxassetid://7142857558",
                "rbxassetid://137364256909483",
                "rbxassetid://133653755194228",
                "rbxassetid://2612674531",
                "rbxassetid://2174790942"
            }
            local blacklist = {"wardrobe", "bed", "rug", "key", "drawer", "book", "breaker", "table", "desk", "gold", "dresser"}

            local validModels = {}
            for _, item in pairs(assetContainer:GetChildren()) do
                if item:IsA("Model") and item.Name ~= "Door" and item.Name ~= "HidingSpots" then
                    local isBlacklisted = false
                    local itemNameLower = string.lower(item.Name)
                    for _, word in ipairs(blacklist) do
                        if string.find(itemNameLower, word) then
                            isBlacklisted = true
                            break
                        end
                    end

                    if not isBlacklisted then
                        table.insert(validModels, item)
                    end
                end
            end

            local soundModelCount = math.max(1, math.floor(#validModels * 0.25))
            local modelsWithSound = {}
            local shuffledModels = {table.unpack(validModels)}
            for i = #shuffledModels, 2, -1 do
                local j = math.random(i)
                shuffledModels[i], shuffledModels[j] = shuffledModels[j], shuffledModels[i]
            end
            
            for i = 1, math.min(soundModelCount, #shuffledModels) do
                modelsWithSound[shuffledModels[i]] = true
            end

            for _, item in ipairs(validModels) do
                local primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")

                if primary then
                    task.spawn(function()
                        for _, v in ipairs(item:GetDescendants()) do
                            if v:IsA("BasePart") then
                                local lowerName = string.lower(v.Name)
                                if not string.find(lowerName, "floor") and not string.find(lowerName, "hitbox") then
                                    v.Anchored = false
                                    v.CanCollide = true 
                                    v.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.01, 0.5, 1, 1)

                                    pcall(function()
                                        if v:CanSetNetworkOwnership() then
                                            v:SetNetworkOwner(localPlayer)
                                        end
                                    end)

                                    v.CFrame = v.CFrame + Vector3.new(0, 0.05, 0)
                                end
                            end
                        end
                    end)

                    if modelsWithSound[item] then
                        task.spawn(function()
                            task.wait(math.random(1, 10) / 100)
                            local randomSoundId = breakSounds[math.random(1, #breakSounds)]
                            local s = Instance.new("Sound")
                            s.SoundId = randomSoundId
                            s.Volume = math.random(12, 22) / 10 
                            s.PlaybackSpeed = math.random(85, 115) / 100
                            s.RollOffMaxDistance = 80
                            s.Parent = primary
                            s:Play()
                            s.Ended:Connect(function() s:Destroy() end)
                        end)
                    end

                    primary.Anchored = true
                    task.wait()
                    primary.Anchored = false

                    primary.AssemblyLinearVelocity = Vector3.new(
                        math.random(-60, 60),
                        math.random(20, 50),
                        math.random(-60, 60)
                    )

                    primary.AssemblyAngularVelocity = Vector3.new(
                        math.random(-25, 25),
                        math.random(-25, 25),
                        math.random(-25, 25)
                    )
                end
            end
        end)
    end

    local latestRoomNum = tostring(game.ReplicatedStorage.GameData.LatestRoom.Value)
    if room.Name ~= latestRoomNum then return end
    if hasTriggered then return end

    local entityModel = workspace:FindFirstChild("RipperNotMoving")
    local entityRoot = entityModel and (entityModel:FindFirstChild("HumanoidRootPart") or entityModel:FindFirstChildWhichIsA("BasePart")) 

    local doorModel = room:FindFirstChild("Door")
    local doorPanel = doorModel and doorModel:FindFirstChild("Door")

    if entityModel and entityRoot and doorPanel and doorPanel:IsA("BasePart") then
        hasTriggered = true

        while entityModel and entityModel.Parent and entityRoot and (entityRoot.Position - doorPanel.Position).Magnitude > 8 do
            task.wait()
        end

        if entityModel and entityModel.Parent and entityRoot then
            local doorFreezePos = entityRoot.CFrame
            local freezeConnection

            freezeConnection = RunService.Heartbeat:Connect(function()
                if entityModel and entityModel.Parent and entityRoot then
                    entityRoot.Anchored = true
                    entityRoot.CFrame = doorFreezePos
                    entityRoot.AssemblyLinearVelocity = Vector3.zero
                    entityRoot.AssemblyAngularVelocity = Vector3.zero
                else
                    if freezeConnection then freezeConnection:Disconnect() end
                end
            end)

            local chance = math.random(1, 2)

            task.spawn(function()
                local camera = workspace.CurrentCamera
                local sound5

                -- Setup CameraShaker instance
                local camShaker = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
                    camera.CFrame = camera.CFrame * shakeCf
                end)
                camShaker:Start()

                if chance == 1 then
                    -- Impact camera shake when Ripper hits the door
                    camShaker:ShakeOnce(30, 11.5, 0.1, 2)

                    sound5 = Instance.new("Sound", workspace)
                    sound5.SoundId = "rbxassetid://1837829565"
                    sound5.Volume = 5
                    sound5.PlaybackSpeed = 1
                    sound5:Play()

                    task.wait(3)

                else
                    local originalCFrame = entityRoot.CFrame

                    -- First hit shake
                    camShaker:ShakeOnce(10, 3.5, 0.1, 1)

                    if entityRoot:FindFirstChild("Despawn2") then
                        entityRoot.Despawn2:Play()
                    end

                    task.wait(1)

                    local backCFrame = originalCFrame * CFrame.new(0, 0, 25) 
                    local tweenBackInfo = TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    local tweenBack = TweenService:Create(entityRoot, tweenBackInfo, {CFrame = backCFrame})

                    tweenBack:Play()
                    tweenBack.Completed:Wait()

                    local tweenForwardInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
                    local tweenForward = TweenService:Create(entityRoot, tweenForwardInfo, {CFrame = originalCFrame})
                    tweenForward:Play()
                    task.wait(0.3)

                    -- Second heavy hit shake on re-impact
                    camShaker:ShakeOnce(30, 11.5, 0.1, 2)

                    if entityRoot:FindFirstChild("Despawn3") then entityRoot.Despawn3:Play() end
                    if entityRoot:FindFirstChild("Despawn1") then entityRoot.Despawn1:Play() end
                    if entityRoot:FindFirstChild("DoorOpen1") then entityRoot.DoorOpen1:Play() end

                    task.wait(3)
                end

                if freezeConnection then freezeConnection:Disconnect() end

                -- Check if the door is locked (has a padlock) before trying to break it
                local isLocked = doorModel:FindFirstChild("Lock") ~= nil or (doorModel:FindFirstChild("Door") and doorModel.Door:FindFirstChild("Lock") ~= nil)

                if not isLocked then
                    -- Perform the Door Breaking Effect (Flat/Fallen down flat on the floor)
                    if doorModel then
                        local doorpart = doorModel:FindFirstChild("Door")
                        local promxy = doorpart and doorpart:FindFirstChild("Knob", true) and doorpart.Knob:FindFirstChild("ProximityPrompt")

                        local hiddenPart = doorModel:FindFirstChild("Hidden", true)
                        if hiddenPart and hiddenPart:IsA("BasePart") then
                            hiddenPart.Size = Vector3.new(3, 8, 4)
                        end

                        local doorClone = doorModel:Clone()
                        doorClone.Name = "DoorClone"
                        doorClone.Parent = doorModel.Parent

                        for _, obj in ipairs(doorClone:GetDescendants()) do
                            if obj:IsA("BasePart") then
                                obj.Anchored = false
                                obj.CanCollide = true
                                if obj.Name == "Door" then
                                    obj.CanCollide = false
                                    if obj:FindFirstChild("Open") then
                                        obj.Open.Volume = 0
                                    end
                                end
                            end

                            if obj:IsA("ProximityPrompt") or obj.Name == "DoorBarrier" or obj.Name == "BarrierTrigger" then
                                obj:Destroy()
                            end
                        end

                        local cloneRoot = doorClone.PrimaryPart or doorClone:FindFirstChildWhichIsA("BasePart")
                        if cloneRoot then
                            -- Rotate the door to lay flat flat on the floor (flat face down/up)
                            cloneRoot.CFrame = cloneRoot.CFrame * CFrame.Angles(math.rad(90), 0, 0)
                            local pushDirection = cloneRoot.CFrame.LookVector
                            cloneRoot.AssemblyLinearVelocity = (pushDirection * 15) + Vector3.new(0, -2, 0)
                            cloneRoot.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end

                        for _, obj in ipairs(doorModel:GetDescendants()) do
                            if obj:IsA("BasePart") then
                                obj.Transparency = 1
                            end

                            if obj:IsA("ProximityPrompt") or obj.Name == "DoorBarrier" or obj.Name == "BarrierTrigger" or obj.Name == "Sign" then
                                obj:Destroy()
                            end
                        end
                    end
                else
                    -- If locked, just open it normally via ClientOpen so it doesn't break a locked door
                    if doorModel and doorModel:FindFirstChild("ClientOpen") then
                        doorModel.ClientOpen:FireServer()
                    end
                end

                -- Smoothly move down to -10000 over 1.5 seconds so sounds fade out naturally
                if entityModel and entityModel.Parent and entityRoot then
                    local voidCFrame = entityRoot.CFrame - Vector3.new(0, 10000, 0)
                    local voidTween = TweenService:Create(entityRoot, TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {CFrame = voidCFrame})
                    voidTween:Play()
                    voidTween.Completed:Wait()

                    if entityModel and entityModel.Parent then
                        entityModel:Destroy()
                    end
                end

                local success, achievementGiver = pcall(function()
                    return loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
                end)

                if success and achievementGiver then
                    achievementGiver({
                        Title = "Torn Apart",
                        Desc = "Don't Leave too Early",
                        Reason = "Encounter and survive RIPPER.",
                        Image = "rbxassetid://12231244908"
                    })
                end

                task.wait(2)
                hasTriggered = false 
            end)
        end
    end
end)

