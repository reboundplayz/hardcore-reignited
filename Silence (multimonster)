local Kill = true
local isChasing = false
local minigamePassed = false
local currentRooms = workspace:WaitForChild("CurrentRooms")
local Removed = false
local RemoveSilence

RemoveSilence = function()
    if Removed then return end
    Removed = true
    Kill = false

    StopMonochromeTint()

    if Silence and Silence.Parent then
        local tweenUp = TweenService:Create(
            Silence,
            TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { CFrame = Silence.CFrame * CFrame.new(0, 80, 0) }
        )
        tweenUp:Play()
        tweenUp.Completed:Wait()
    end

    if Silence5 and Silence5.Parent then
        Silence5:Destroy()
    end
end

local function DespawnToNextRoom()
    Kill = false
    isChasing = false
    
    local latestRoomVal = ReplicatedStorage.GameData.LatestRoom.Value
    local nextRoom = currentRooms:FindFirstChild(tostring(latestRoomVal + 1)) or currentRooms:FindFirstChild(latestRoomVal + 1)
    local exitCFrame = HRP.CFrame * CFrame.new(0, 80, -40)

    if nextRoom then
        local entrance = nextRoom:FindFirstChild("RoomEntrance") or nextRoom.PrimaryPart
        if entrance then exitCFrame = entrance.CFrame * CFrame.new(0, 70, 0) end
    end

    if Silence and Silence.Parent then
        Silence.Anchored = true
        local tweenAway = TweenService:Create(
            Silence,
            TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = exitCFrame }
        )
        tweenAway:Play()
        tweenAway.Completed:Wait()
    end

    RemoveSilence()
end

