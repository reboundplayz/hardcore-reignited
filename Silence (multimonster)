local inMinigame = false

local function TriggerPlayerDeath()
    if minigamePassed then return end

    if heartbeatMessupSound then
        heartbeatMessupSound:Play()
    end

    Humanoid.Health = 0
    pcall(function()
        ReplicatedStorage.GameStats["Player_" .. LocalPlayer.Name].Total.DeathCause.Value = "Silence"
    end)
    
    local deathSound = Instance.new("Sound")
    deathSound.SoundId = "rbxassetid://4988621968"
    deathSound.Volume = 10
    deathSound.PlaybackSpeed = 0.7
    deathSound.Parent = workspace
    deathSound:Play()
    Debris:AddItem(deathSound, 3)

    if RemoveSilence then RemoveSilence() end
end

local function StartHeartbeatMinigame()
    if inMinigame or not isChasing then return end
    inMinigame = true

    if heartbeatStartSound then
        heartbeatStartSound:Play()
    end

    -- Play "listen..." text with animation
    StartText("listen...", 3)
    LaunchText(false, Color3.fromRGB(205, 170, 255))

    -- Instantly move Silence directly outside the closet door
    if Silence and Silence.Parent and HRP then
        Silence.Anchored = true
        TweenService:Create(
            Silence,
            TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { CFrame = HRP.CFrame * CFrame.new(0, 0, -4) }
        ):Play()
    end

    local isTouch = UserInputService.TouchEnabled
    local baseHeartSize = isTouch and 120 or 220
    local popHeartSize = isTouch and 150 or 260
    local tapHeartSize = isTouch and 140 or 240

    local heartbeatGui = Instance.new("ScreenGui")
    heartbeatGui.Name = "HeartbeatMinigame"
    heartbeatGui.IgnoreGuiInset = true
    heartbeatGui.DisplayOrder = 999999
    heartbeatGui.Parent = LocalPlayer.PlayerGui

    local mainButton = Instance.new("ImageButton")
    mainButton.Name = "HeartLabel"
    mainButton.Image = "rbxassetid://8419306829"
    mainButton.Size = UDim2.new(0, baseHeartSize, 0, baseHeartSize)
    mainButton.Position = UDim2.new(0.5, 0, 0.82, 0)
    mainButton.AnchorPoint = Vector2.new(0.5, 0.5)
    mainButton.BackgroundTransparency = 1
    mainButton.Parent = heartbeatGui

    -- Static Instruction Label above the heart
    local keepBeatText = Instance.new("TextLabel")
    keepBeatText.Name = "KeepBeatLabel"
    keepBeatText.AnchorPoint = Vector2.new(0.5, 1)
    keepBeatText.Position = UDim2.new(0.5, 0, 0.82, - (baseHeartSize / 2 + 10))
    keepBeatText.Size = UDim2.new(0, 400, 0, 40)
    keepBeatText.BackgroundTransparency = 1
    keepBeatText.Text = "Keep the beat."
    keepBeatText.TextColor3 = Color3.fromRGB(255, 255, 255)
    keepBeatText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    keepBeatText.TextStrokeTransparency = 0.8
    keepBeatText.TextScaled = true
    keepBeatText.Font = Enum.Font.Oswald
    keepBeatText.TextTransparency = 1
    keepBeatText.TextStrokeTransparency = 1
    keepBeatText.ZIndex = 10
    keepBeatText.Parent = heartbeatGui

    local hidingCheck
    hidingCheck = Character:GetAttributeChangedSignal("Hiding"):Connect(function()
        if not Character:GetAttribute("Hiding") and not minigamePassed then
            TriggerPlayerDeath()
            if heartbeatGui then heartbeatGui:Destroy() end
            if hidingCheck then hidingCheck:Disconnect() end
        end
    end)

    task.wait(1)

    local beatDelays = {}
    for i = 1, 5 do
        beatDelays[i] = math.random(40, 85) / 100
    end

    for i = 1, 6 do
        if not Kill or Humanoid.Health <= 0 or not Character:GetAttribute("Hiding") then break end

        if heartbeatHitSound then
            heartbeatHitSound:Play()
        end

        TweenService:Create(mainButton, TweenInfo.new(0.1), {Size = UDim2.new(0, popHeartSize, 0, popHeartSize)}):Play()
        task.delay(0.1, function()
            if mainButton and mainButton.Parent then
                TweenService:Create(mainButton, TweenInfo.new(0.1), {Size = UDim2.new(0, baseHeartSize, 0, baseHeartSize)}):Play()
            end
        end)

        if i < 6 then
            task.wait(beatDelays[i])
        end
    end

    task.wait(0.2)

    if Kill and Humanoid.Health > 0 and Character:GetAttribute("Hiding") then
        -- Fade in "Keep the beat." above the heart
        TweenService:Create(keepBeatText, TweenInfo.new(0.4), {
            TextTransparency = 0,
            TextStrokeTransparency = 0.8
        }):Play()

        local playerInputTimes = {}
        local inputConnection, keyConnection

        local function registerTap()
            table.insert(playerInputTimes, os.clock())
            
            if heartbeatHitSound then
                heartbeatHitSound:Play()
            end

            TweenService:Create(mainButton, TweenInfo.new(0.08), {Size = UDim2.new(0, tapHeartSize, 0, tapHeartSize)}):Play()
            task.delay(0.08, function()
                if mainButton and mainButton.Parent then
                    TweenService:Create(mainButton, TweenInfo.new(0.08), {Size = UDim2.new(0, baseHeartSize, 0, baseHeartSize)}):Play()
                end
            end)
        end

        inputConnection = mainButton.MouseButton1Click:Connect(registerTap)
        if UserInputService.KeyboardEnabled then
            keyConnection = UserInputService.InputBegan:Connect(function(input, gpe)
                if input.KeyCode == Enum.KeyCode.Space and not gpe then
                    registerTap()
                end
            end)
        end

        local startTime = os.clock()
        local maxWaitTime = 7.0

        while #playerInputTimes < 6 and (os.clock() - startTime) < maxWaitTime and Humanoid.Health > 0 and Character:GetAttribute("Hiding") do
            task.wait(0.02)
        end

        if inputConnection then inputConnection:Disconnect() end
        if keyConnection then keyConnection:Disconnect() end

        local beatPassed = false
        if #playerInputTimes == 6 then
            beatPassed = true
            local TOLERANCE = 0.28

            for i = 1, 5 do
                local actualInterval = playerInputTimes[i+1] - playerInputTimes[i]
                local targetInterval = beatDelays[i]

                if math.abs(actualInterval - targetInterval) > TOLERANCE then
                    beatPassed = false
                    break
                end
            end
        end

        -- Fade out static text
        TweenService:Create(keepBeatText, TweenInfo.new(0.3), {
            TextTransparency = 1,
            TextStrokeTransparency = 1
        }):Play()

        if not beatPassed then
            mainButton.ImageColor3 = Color3.fromRGB(255, 60, 60)
            TriggerPlayerDeath()
        else
            minigamePassed = true
            
            -- Turn heart green on survival
            mainButton.ImageColor3 = Color3.fromRGB(85, 255, 127)
            
            -- Display center screen success text
            StartText("steady...", 3)
            LaunchText(false, Color3.fromRGB(85, 255, 127))

            task.delay(0.5, function()
                if heartbeatGui then heartbeatGui:Destroy() end
            end)
            if hidingCheck then hidingCheck:Disconnect() end

            DespawnToNextRoom()
        end
    end

    if hidingCheck then hidingCheck:Disconnect() end
    if heartbeatGui then heartbeatGui:Destroy() end
    inMinigame = false
end

--------------------------------------------------------------------------------
-- 8. CHASE SEQUENCE & MOVEMENT CHECK
--------------------------------------------------------------------------------
local lastPos = HRP.Position
local damageInterval = 0.054
local thread = nil

local function StartChaseSequence()
    if isChasing or minigamePassed then return end
    isChasing = true

    if silenceHeardSound then
        silenceHeardSound:Play()
    end

    StartText("you were heard.", 3)
    LaunchText(true)
    StartMonochromeTint(true)

    task.wait(3)

    local currentChaseTween = nil

    while Kill and not minigamePassed do
        task.wait(damageInterval)

        if Character:GetAttribute("Hiding") then
            if currentChaseTween then
                currentChaseTween:Cancel()
                currentChaseTween = nil
            end

            if Silence and Silence.Parent then
                Silence.Anchored = true
            end

            if not inMinigame then
                StartHeartbeatMinigame()
            end
        end

        if not inMinigame and not Character:GetAttribute("Hiding") and not minigamePassed then
            local currentPos = HRP.Position

            if Humanoid.Health > 0 then
                Silence.Anchored = true

                local s = Instance.new("Sound")
                s.SoundId = "rbxassetid://7861818231"
                s.Volume = 0.5
                s.Parent = workspace
                s:Play()
                Debris:AddItem(s, 2)

                local SPEED_STUDS_PER_SECOND = 28
                local targetCFrame = HRP.CFrame
                local distance = (targetCFrame.Position - Silence.Position).Magnitude
                local duration = distance / SPEED_STUDS_PER_SECOND

                if duration <= 0 then duration = 0.05 end

                currentChaseTween = TweenService:Create(
                    Silence,
                    TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
                    {CFrame = targetCFrame}
                )
                currentChaseTween:Play()

                local isCrouching = Character:GetAttribute("Crouching") == true
                local movedUncrouchedInRoom = IsPlayerInRoom(activeRoom) and not isCrouching and (currentPos - lastPos).Magnitude > 0.3

                if distance <= 9 or movedUncrouchedInRoom then
                    TriggerPlayerDeath()
                    break
                end
            end
            lastPos = currentPos
        end
    end
end

thread = task.spawn(function()
    while Kill and not isChasing and not minigamePassed do
        task.wait(0.1)
        local currentPos = HRP.Position
        local isCrouching = Character:GetAttribute("Crouching") == true

        if IsPlayerInRoom(activeRoom) and not isCrouching and (currentPos - lastPos).Magnitude > 0.3 then
            StartChaseSequence()
            break
        end
        lastPos = currentPos
    end
end)
