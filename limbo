end

local function thunderFlash()
	local v1 = t3.attacking and t2.AttackSkyboxColor or t2.SkyboxColors[1]
	local v2 = t3.attacking and t2.SurfaceLightAttack or t2.SurfaceLightStorm

	for _, v in ipairs(getWindows()) do
		for _, v3 in ipairs(v:GetDescendants()) do
			if v3:IsA("Light") and v3.Name == "Lightning" then
				v3.Color = t2.FlashColor
				v3.Brightness = t2.LightningBrightness
				TweenService:Create(v3, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
				continue
			end

			if v3:IsA("Light") and v3.Name == "SurfaceLight" then
				t3.snapshots[v3] = t3.snapshots[v3] or {}
				if t3.snapshots[v3].Brightness == nil then t3.snapshots[v3].Brightness = v3.Brightness end
				if t3.snapshots[v3].Color == nil then t3.snapshots[v3].Color = v3.Color end

				v3.Color = t2.FlashColor
				v3.Brightness = t2.LightningBrightness
				TweenService:Create(v3, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Brightness = v2,
					Color = t2.VignetteColor
				}):Play()
				continue
			end

			if v3:IsA("BasePart") and v3.Name == "Skybox" then
				t3.snapshots[v3] = t3.snapshots[v3] or {}
				if t3.snapshots[v3].Color == nil then t3.snapshots[v3].Color = v3.Color end

				v3.Color = t2.FlashColor
				TweenService:Create(v3, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Color = v1 }):Play()
				continue
			end

			if v3:IsA("Sound") and v3.Name == "Thunder" then
				local range = t2.ThunderSpeedRange
				v3.PlaybackSpeed = range[1] + math.random() * (range[2] - range[1])
				v3.Volume = t2.ThunderVolume
				v3:Play()
			end
		end
	end

	t3.snapshots[Lighting] = t3.snapshots[Lighting] or {}
	if t3.snapshots[Lighting].Brightness == nil then
		t3.snapshots[Lighting].Brightness = Lighting.Brightness
	end

	Lighting.Brightness = 2
	TweenService:Create(Lighting, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = t2.DarkBrightness
	}):Play()
end

local function applyRoomBaseLighting(p1)
	for _, v in ipairs(getRoomLights(p1)) do
		t3.snapshots[v] = t3.snapshots[v] or {}
		if t3.snapshots[v].Enabled == nil then t3.snapshots[v].Enabled = v.Enabled end
		if t3.snapshots[v].Brightness == nil then t3.snapshots[v].Brightness = v.Brightness end
		if t3.snapshots[v].Color == nil then t3.snapshots[v].Color = v.Color end

		TweenService:Create(v, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Brightness = (t3.snapshots[v].Brightness or v.Brightness) * t2.DimLightFactor
		}):Play()
	end

	for _, v in ipairs(getRoomNeons(p1)) do
		t3.snapshots[v] = t3.snapshots[v] or {}
		if t3.snapshots[v].Color == nil then t3.snapshots[v].Color = v.Color end

		TweenService:Create(v, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Color = t2.DimNeonColor
		}):Play()
	end
end

local function purpleFlicker()
	local v1 = Random.new(tick())
	for _, v in ipairs(CurrentRooms:GetChildren()) do
		local v2 = math.random(6, 12) / 10
		local modified = {}

		for _, v3 in ipairs(getRoomNeons(v)) do
			if math.random() < t2.PurpleBulbChance then
				t3.snapshots[v3] = t3.snapshots[v3] or {}
				if t3.snapshots[v3].Color == nil then t3.snapshots[v3].Color = v3.Color end

				v3.Color = t2.FlickerColor
				table.insert(modified, v3)

				for _, v4 in ipairs(v3.Parent:GetDescendants()) do
					if v4:IsA("Light") then
						t3.snapshots[v4] = t3.snapshots[v4] or {}
						if t3.snapshots[v4].Color == nil then t3.snapshots[v4].Color = v4.Color end
						v4.Color = t2.FlickerColor
						table.insert(modified, v4)
					end
				end
			end
		end

		Module_Events.flicker(v, v2, 100, v1)
		task.delay(v2 + 0.4, function()
			for _, item in ipairs(modified) do
				if item and item.Parent then
					if item:IsA("BasePart") then
						item.Color = t2.DimNeonColor
					else
						item.Color = t3.snapshots[item] and t3.snapshots[item].Color or item.Color
					end
				end
			end
		end)
	end

	if t3.state and t3.state.camShaker then
		local r = t2.FlickerRumble
		pcall(function() t3.state.camShaker:ShakeOnce(r[1], r[2], r[3], r[4]) end)
	end
end

local function restoreAll(p1)
	for k, v in pairs(t3.snapshots) do
		if k and k.Parent then
			for k2, v2 in pairs(v) do
				local valType = typeof(v2)
				if valType == "number" or valType == "Color3" then
					TweenService:Create(k, TweenInfo.new(p1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						[k2] = v2
					}):Play()
				else
					k[k2] = v2
				end
			end
		end
	end
	task.delay(p1, function() t3.snapshots = {} end)
end

local function updateAmbienceForRoom()
	if t3.suspended or not t3.ambience then return end

	local v1 = LocalPlayer:GetAttribute("CurrentRoom")
	local v2 = if v1 then CurrentRooms:FindFirstChild(tostring(v1)) else v1
	local vol, hGain, mGain

	if v2 and not roomIsWindowless(v2) then
		vol, hGain, mGain = t2.AmbienceVolume, 0, 0
	else
		vol, hGain, mGain = t2.WindowlessAmbienceVolume, -22, -8
	end

	TweenService:Create(t3.ambience, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Volume = vol }):Play()
	if t3.ambienceEq then
		TweenService:Create(t3.ambienceEq, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			HighGain = hGain,
			MidGain = mGain
		}):Play()
	end
end

local function startAmbience()
	local Sound = Instance.new("Sound")
	Sound.SoundId = t2.Ambience
	Sound.Looped = true

	local Main = SoundService:FindFirstChild("Main")
	Sound.SoundGroup = if Main then Main:FindFirstChild("Ambience") or Main else nil

	local v2 = LocalPlayer:GetAttribute("CurrentRoom")
	local v3 = if v2 then CurrentRooms:FindFirstChild(tostring(v2)) else v2
	Sound.Volume = if v3 and not roomIsWindowless(v3) then t2.AmbienceVolume else t2.WindowlessAmbienceVolume

	local LimboMuffle = Instance.new("EqualizerSoundEffect")
	LimboMuffle.Name = "LimboMuffle"
	LimboMuffle.Parent = Sound
	Sound.Parent = SoundService

	Sound.DidLoop:Connect(function()
		Sound.TimePosition = t2.AmbienceLoopStart
	end)
	Sound:Play()

	t3.ambience = Sound
	t3.ambienceEq = LimboMuffle
end

local function stopAmbience(p1)
	if not t3.ambience then return end

	local ambience = t3.ambience
	t3.ambience, t3.ambienceEq = nil, nil

	if p1 then
		ambience:Stop()
		ambience:Destroy()
		return
	end

	TweenService:Create(ambience, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Volume = 0 }):Play()
	task.delay(2, function() ambience:Destroy() end)
end

