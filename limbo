local function ensureSicknessEffects()
	if not t3.colorCorrection then
		local LimboSickness = Instance.new("ColorCorrectionEffect")
		LimboSickness.Name = "LimboSickness"
		LimboSickness.TintColor = Color3.fromRGB(255, 255, 255)
		LimboSickness.Parent = Lighting
		t3.colorCorrection = LimboSickness
	end

	if not t3.blur then
		local LimboBlur = Instance.new("BlurEffect")
		LimboBlur.Name = "LimboBlur"
		LimboBlur.Size = 0
		LimboBlur.Parent = Lighting
		t3.blur = LimboBlur
	end
end

local function updateSickness(p1)
	if not t3.suspended then
		ensureSicknessEffects()
		local v1 = math.clamp(p1, 0, 1)
		TweenService:Create(t3.colorCorrection, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			TintColor = Color3.fromRGB(255, 255, 255):Lerp(t2.VignetteColor, v1),
			Saturation = t2.MaxSaturation * v1
		}):Play()
		TweenService:Create(t3.blur, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = t2.MaxBlur * v1
		}):Play()
	end
end

local function bindCharacter()
	for _, v2 in ipairs({ "bar", "sick", "died", "health" }) do
		if t3.connections[v2] then
			t3.connections[v2]:Disconnect()
			t3.connections[v2] = nil
		end
	end

	local Character = LocalPlayer.Character
	t3.boundCharacter = Character

	if Character then
		local deadState = false

		t3.connections.bar = Character:GetAttributeChangedSignal("LimboBar"):Connect(function()
			updateBar(Character:GetAttribute("LimboBar") or 0)
		end)
		t3.connections.sick = Character:GetAttributeChangedSignal("LimboSickness"):Connect(function()
			updateSickness(Character:GetAttribute("LimboSickness") or 0)
		end)

		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
		if Humanoid then
			if Humanoid.Health <= 0 then deadState = true end

			t3.connections.died = Humanoid.Died:Connect(function()
				deadState = true
				if (t3.attackValue or 0) >= 100 or (Character:GetAttribute("LimboBar") or 0) >= 1 then
					playDeathSound()
				end

				if t3.barFill then
					TweenService:Create(t3.barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.new(1, 0, 0, 0)
					}):Play()
				end
				updateSickness(0)
				if t3.barHolder then
					TweenService:Create(t3.barHolder, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Position = UDim2.new(-0.12, 0, 0.5, 0)
					}):Play()
				end
			end)

			t3.connections.health = Humanoid.HealthChanged:Connect(function(p1)
				if not (deadState and p1 > 0) then return end
				deadState = false
				updateBar(Character:GetAttribute("LimboBar") or 0)
				updateSickness(Character:GetAttribute("LimboSickness") or 0)
				if t3.active and t3.barHolder then
					TweenService:Create(t3.barHolder, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Position = UDim2.new(0.03, 0, 0.5, 0)
					}):Play()
				end
			end)
		end

		updateBar(Character:GetAttribute("LimboBar") or 0)
		updateSickness(Character:GetAttribute("LimboSickness") or 0)

		if t3.active and not deadState and t3.barHolder then
			TweenService:Create(t3.barHolder, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(0.03, 0, 0.5, 0)
			}):Play()
		end
	end

	if not t3.connections.room then
		t3.connections.room = LocalPlayer:GetAttributeChangedSignal("CurrentRoom"):Connect(updateAmbienceForRoom)
	end

	if not t3.connections.charAdded then
		t3.connections.charAdded = LocalPlayer.CharacterAdded:Connect(function(p1)
			if t3.active then
				p1:WaitForChild("Humanoid", 5)
				bindCharacter()
			end
		end)
	end
end

local function onRoomAdded(p1)
	if not t3.active or t3.suspended then return end
	task.wait(0.1)
	applyRoomBaseLighting(p1)

	for _, v in ipairs(p1:GetDescendants()) do
		if v:IsA("Model") and (v.Name == "Window" or v.Name == "Window_Tall") then
			styleWindow(v, t3.attacking, 0.5)
		end
	end
	updateAmbienceForRoom()
end

local function lightningLoop(p1)
	while t3.active and t3.loopGen == p1 do
		task.wait(math.random(t2.RandomLightning[1], t2.RandomLightning[2]))
		if t3.active and t3.loopGen == p1 then
			thunderFlash()
		end
	end
end

local function attackThunderLoop()
	while t3.active and t3.attacking do
		thunderFlash()
		task.wait(math.random(6, 19) / 100)
	end
end

local function attackLightValueLoop()
	if t3.valueLoopRunning then return end
	t3.valueLoopRunning = true

	t3.attackValue = t3.attackValue or 0

	while t3.active and (t3.attacking or t3.attackValue > 0) do
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")

		if hum and hum.Health > 0 then
			local inHitbox = t3.attacking and isPlayerInLight()

			if inHitbox then
				t3.attackValue = math.clamp(t3.attackValue + 1, 0, 100)
			else
				t3.attackValue = math.clamp(t3.attackValue - 0.025, 0, 100)
			end

			local progress = t3.attackValue / 100
			char:SetAttribute("LimboBar", progress)
			char:SetAttribute("LimboSickness", progress)

			if t3.attackValue >= 100 then
				playDeathSound()
				hum.Health = 0
				break
			end
		end

		task.wait(0.1)
	end

	t3.valueLoopRunning = false
end

local function flickerLoop(p1)
	while t3.active and t3.loopGen == p1 do
		task.wait(math.random(t2.FlickerInterval[1], t2.FlickerInterval[2]))
		if t3.active and t3.loopGen == p1 then
			purpleFlicker()
		end
	end
end

local function startLoops()
	t3.loopGen = (t3.loopGen or 0) + 1
	local loopGen = t3.loopGen

	task.spawn(lightningLoop, loopGen)
	task.spawn(flickerLoop, loopGen)
	task.spawn(function()
		while t3.active and t3.loopGen == loopGen do
			task.wait(0.5)
			if not t3.active or (LocalPlayer.Character == nil or LocalPlayer.Character == t3.boundCharacter) then
				continue
			end
			bindCharacter()
		end
	end)
end

-- MODULE FUNCTIONS
function t.intro(p1)
	if p1 and p1.dead then return end
	if t3.active then return end

	t3.active = true
	t3.attacking = false
	t3.suspended = false
	t3.state = p1
	t3.snapshots = {}

	pcall(function() Module_Events.init(p1) end)
	buildBar()
	ensureSicknessEffects()
	bindCharacter()

	if t3.barHolder then
		TweenService:Create(t3.barHolder, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.03, 0, 0.5, 0)
		}):Play()
	end

	t3.snapshots[Lighting] = t3.snapshots[Lighting] or {}
	if t3.snapshots[Lighting].Brightness == nil then t3.snapshots[Lighting].Brightness = Lighting.Brightness end
	if t3.snapshots[Lighting].Ambient == nil then t3.snapshots[Lighting].Ambient = Lighting.Ambient end
	if t3.snapshots[Lighting].OutdoorAmbient == nil then t3.snapshots[Lighting].OutdoorAmbient = Lighting.OutdoorAmbient end

	TweenService:Create(Lighting, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = t2.DarkBrightness,
		Ambient = t2.DarkAmbient,
		OutdoorAmbient = t2.DarkAmbient
	}):Play()

	for _, v in ipairs(CurrentRooms:GetChildren()) do
		applyRoomBaseLighting(v)
	end

	task.spawn(function()
		styleAllWindows(false, t2.IntroTime)
		for i = 1, 6 do
			local color = i % 2 == 0 and t2.SkyboxColors[1] or t2.SkyboxColors[i % #t2.SkyboxColors + 1]
			for _, v in ipairs(getWindows()) do
				for _, v2 in ipairs(v:GetDescendants()) do
					if v2:IsA("BasePart") and v2.Name == "Skybox" then
						TweenService:Create(v2, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Color = color
						}):Play()
					end
				end
			end
			task.wait(0.12)
		end
		styleAllWindows(false, 0.5)
	end)

	thunderFlash()
	startAmbience()
	updateAmbienceForRoom()

	if p1 and p1.camShaker then
		local shake = t2.IntroShake
		pcall(function() p1.camShaker:ShakeOnce(shake[1], shake[2], shake[3], shake[4]) end)
	end

	t3.connections.rooms = CurrentRooms.ChildAdded:Connect(onRoomAdded)
	startLoops()
end

function t.attack(p1, p2, p3)
	if not t3.active or t3.suspended or (p1 and p1.dead) then return end
	if LocalPlayer.Character ~= nil and LocalPlayer.Character ~= t3.boundCharacter then
		t.reintro(p1)
	end
	if t3.attacking then return end

	t3.attacking = true
	task.spawn(attackThunderLoop)
	task.spawn(attackLightValueLoop)

	local Sound = GetGitSound("https://github.com/eoyoustme/Impossible/blob/main/limbo%20ambience%20riser%202.mp3?raw=true", "limbovmvmvm")
	if Sound then
		Sound.Parent = workspace
		Sound.Volume = 1.5
		Sound.PlaybackSpeed = 1
		Sound:Play()
	end
	local Main = SoundService:FindFirstChild("Main")
	Sound.SoundGroup = if Main then Main:FindFirstChild("Ambience") or Main else nil
	Sound.Parent = SoundService
	Sound:Play()
	Debris:AddItem(Sound, 30)

	styleAllWindows(true, p3 or 2)
	thunderFlash()

	if p1 and p1.camShaker then
		local shake = t2.AttackShake
		pcall(function() p1.camShaker:ShakeOnce(shake[1], shake[2], p2 or 2, 0.3) end)
	end
end

function t.calmReset(p1)
	if not t3.active then return end
	t3.attacking = false
	if t3.suspended or (p1 and p1.dead) then return end

	thunderFlash()
	styleAllWindows(false, 0.4)

	if p1 and p1.camShaker then
		local shake = t2.FinalShake
		pcall(function() p1.camShaker:ShakeOnce(shake[1], shake[2], shake[3], shake[4]) end)
	end
end

function t.despawn(p1, p2)
	if not t3.active then return end
	local suspendedOrDead = t3.suspended or (if p1 then p1.dead else p1)

	t3.active = false
	t3.attacking = false
	t3.suspended = false
	local dur = p2 or 12

	if suspendedOrDead then
		if t3.ambience then stopAmbience(true) end
		restoreAll(dur)
		for k, v in pairs(t3.connections) do
			v:Disconnect()
			t3.connections[k] = nil
		end
		if t3.colorCorrection then t3.colorCorrection:Destroy() t3.colorCorrection = nil end
		if t3.blur then t3.blur:Destroy() t3.blur = nil end
		if t3.barGui then t3.barGui:Destroy() t3.barGui = nil end
		t3.barHolder, t3.barFill = nil, nil
	else
		local Sound = Instance.new("Sound")
		Sound.SoundId = t2.EndSound
		Sound.Volume = 3.25
		local Main = SoundService:FindFirstChild("Main")
		Sound.SoundGroup = if Main then Main:FindFirstChild("Ambience") or Main else nil
		Sound.Parent = SoundService
		Sound:Play()
		Debris:AddItem(Sound, 30)

		thunderFlash()
		restoreAll(dur)

		if t3.barFill then
			TweenService:Create(t3.barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(1, 0, 0, 0)
			}):Play()
		end
		if t3.barHolder then
			TweenService:Create(t3.barHolder, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = UDim2.new(-0.12, 0, 0.5, 0)
			}):Play()
		end

		stopAmbience()
		updateSickness(0)

		if p1 and p1.camShaker then
			local shake = t2.DespawnShake
			pcall(function() p1.camShaker:ShakeOnce(shake[1], shake[2], shake[3], shake[4]) end)
		end

		task.delay(dur, function()
			if t3.active then return end
			for k, v in pairs(t3.connections) do
				v:Disconnect()
				t3.connections[k] = nil
			end
			if t3.colorCorrection then t3.colorCorrection:Destroy() t3.colorCorrection = nil end
			if t3.blur then t3.blur:Destroy() t3.blur = nil end
			if t3.barGui then t3.barGui:Destroy() t3.barGui = nil end
			t3.barHolder, t3.barFill = nil, nil
		end)
	end
end

getgenv().Limbo = t

local mockState = {
	dead = false,
	camShaker = {
		ShakeOnce = function() end
	}
}

t.intro(mockState)

task.spawn(function()
	task.spawn(function()
		while true do
			task.wait(10)
			t.attack(mockState)
			task.wait(5)
			t.calmReset(mockState)
		end
	end)

	task.wait(80)
	t.despawn(mockState, 3)
end)
