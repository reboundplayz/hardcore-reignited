local function getWindows()
	local windows = {}
	for _, v in ipairs(CurrentRooms:GetChildren()) do
		for _, v2 in ipairs(v:GetDescendants()) do
			if v2:IsA("Model") and (v2.Name == "Window" or v2.Name == "Window_Tall") then
				table.insert(windows, v2)
			end
		end
	end
	return windows
