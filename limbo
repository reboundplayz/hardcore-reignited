local function getWindowLights(p1)
	local lights = {}
	for _, v in ipairs(p1:GetDescendants()) do
		if v:IsA("Model") and (v.Name == "Window" or v.Name == "Window_Tall") then
			for _, child in ipairs(v:GetDescendants()) do
				if child:IsA("Light") and child.Parent and child.Parent:IsA("BasePart") then
					table.insert(lights, { light = child, windowModel = v })
				end
			end
		end
	end
	return lights
end

local function isPlayerInLight()
	local char = LocalPlayer.Character
	if not char then return false end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local head = char:FindFirstChild("Head")
	if not hrp then return false end

	local roomNum = LocalPlayer:GetAttribute("CurrentRoom")
	if not roomNum then return false end
	local room = CurrentRooms:FindFirstChild(tostring(roomNum))
	if not room then return false end

	local checkPoints = {
		hrp.Position,
		head and head.Position or (hrp.Position + Vector3.new(0, 1.5, 0)),
		hrp.Position - Vector3.new(0, 2, 0)
	}

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true

	for _, item in ipairs(getWindowLights(room)) do
		local light = item.light
		local windowModel = item.windowModel

		if light.Enabled and light.Brightness > 0.05 and light.Parent and light.Parent:IsA("BasePart") then
			local lightPart = light.Parent
			local lightPos = lightPart.Position

			raycastParams.FilterDescendantsInstances = { char, lightPart, windowModel }

			for _, targetPos in ipairs(checkPoints) do
				local toTarget = targetPos - lightPos
				local dist = toTarget.Magnitude

				local maxRange = light.Range > 0 and light.Range or 25
				if dist <= maxRange then

					local inCone = true
					if light:IsA("SpotLight") then
						local faceVector = Vector3.FromNormalId(light.Face)
						local lightDir = lightPart.CFrame:VectorToWorldSpace(faceVector)
						local angle = math.deg(math.acos(math.clamp(lightDir:Dot(toTarget.Unit), -1, 1)))

						if angle > (light.Angle / 2) then
							inCone = false
						end
					elseif light:IsA("SurfaceLight") then
						local faceVector = Vector3.FromNormalId(light.Face)
						local lightDir = lightPart.CFrame:VectorToWorldSpace(faceVector)

						if lightDir:Dot(toTarget.Unit) <= 0 then
							inCone = false
						end
					end

					if inCone then
						local offset = 5

						if dist <= offset then
							return true
						else
							local startPos = lightPos + (toTarget.Unit * offset)
							local rayDirection = toTarget - (toTarget.Unit * offset)

							local result = workspace:Raycast(startPos, rayDirection, raycastParams)

							if not result then
								return true
							end
						end
					end
				end
			end
		end
	end

	return false
end

local function styleWindow(p1, p2, p3)
	for _, v in ipairs(p1:GetDescendants()) do
		if v:IsA("BasePart") and v.Name == "Skybox" then
			t3.snapshots[v] = t3.snapshots[v] or {}
			if t3.snapshots[v].Color == nil then t3.snapshots[v].Color = v.Color end
			TweenService:Create(v, TweenInfo.new(p3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Color = p2 and t2.AttackSkyboxColor or t2.SkyboxColors[1]
			}):Play()
			continue
		end

		if v:IsA("Light") and v.Name == "SurfaceLight" then
			t3.snapshots[v] = t3.snapshots[v] or {}
			if t3.snapshots[v].Brightness == nil then t3.snapshots[v].Brightness = v.Brightness end
			if t3.snapshots[v].Color == nil then t3.snapshots[v].Color = v.Color end
			TweenService:Create(v, TweenInfo.new(p3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Brightness = p2 and t2.SurfaceLightAttack or t2.SurfaceLightStorm,
				Color = t2.VignetteColor
			}):Play()
			continue
		end

		if v:IsA("Sound") and v.Name == "PlaySound" then
			t3.snapshots[v] = t3.snapshots[v] or {}
			if t3.snapshots[v].Volume == nil then t3.snapshots[v].Volume = v.Volume end
			if t3.snapshots[v].PlaybackSpeed == nil then t3.snapshots[v].PlaybackSpeed = v.PlaybackSpeed end
			TweenService:Create(v, TweenInfo.new(p3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Volume = t2.GlassSoundVolume
			}):Play()
			v.PlaybackSpeed = t2.GlassSoundSpeed
			continue
		end

		if v:IsA("ParticleEmitter") and (v.Parent and v.Parent.Name == "Glass") then
			t3.snapshots[v] = t3.snapshots[v] or {}
			if t3.snapshots[v].Speed == nil then t3.snapshots[v].Speed = v.Speed end
			v.Speed = t2.RainSpeed
		end
	end
end

local function styleAllWindows(p1, p2)
