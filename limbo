local function insideWindow(p1)
	local v1 = p1.Parent
	while v1 and v1 ~= workspace do
		if v1:IsA("Model") and (v1.Name == "Window" or v1.Name == "Window_Tall") then
			return true
		end
		v1 = v1.Parent
	end
	return false
end

local function getRoomLights(p1)
	local lights = {}
	for _, v in ipairs(p1:GetDescendants()) do
		if (v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight")) and not insideWindow(v) then
			table.insert(lights, v)
		end
	end
	return lights
end

local function getRoomNeons(p1)
	local neons = {}
	for _, v in ipairs(p1:GetDescendants()) do
		if v:IsA("BasePart") and (v.Name == "Neon" and not insideWindow(v)) then
