local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local function GetRoom()
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return nil end

	local gameData = game.ReplicatedStorage:FindFirstChild("GameData")
	local latestRoom = gameData and gameData:FindFirstChild("LatestRoom")

	if latestRoom then
		return currentRooms:FindFirstChild(tostring(latestRoom.Value))
	end
	return nil
end

-- Tải Asset (ID 118098332055688)
local success, assets = pcall(function()
	return game:GetObjects("rbxassetid://118098332055688")
end)

if not success or not assets or #assets == 0 then
	warn("⚠️ Không thể tải được Asset! Kiểm tra lại ID hoặc Executor.")
	return
end

local s = assets[1]
s.Name = "Singularity"
s.Parent = workspace

local entity = s:FindFirstChild("Singu") or s
if not entity then
	warn("⚠️ Không tìm thấy 'Singu' trong Asset!")
	s:Destroy()
	return
end

local room = GetRoom()
if not room then
	warn("⚠️ Không tìm thấy phòng hiện tại!")
	s:Destroy()
	return
end

-- Tìm vị trí Wardrobe linh hoạt
local assetsFolder = room:WaitForChild("Assets", 5)
local wardrobe = assetsFolder and assetsFolder:WaitForChild("Wardrobe", 5)

if not wardrobe then
	warn("⚠️ Không tìm thấy 'Wardrobe' trong Assets!")
	s:Destroy()
	return
end

local wardrobeMain = wardrobe:FindFirstChild("Main") 
	or wardrobe.PrimaryPart 
	or wardrobe:FindFirstChildWhichIsA("BasePart", true)

if not wardrobeMain then
