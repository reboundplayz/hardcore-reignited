	return
end

-- Dịch chuyển Entity lùi lại vào bên trong tủ
local spawnCFrame = wardrobeMain.CFrame * CFrame.new(0, 0, 0.8)
if entity:IsA("Model") then
	entity:PivotTo(spawnCFrame)
else
	entity.CFrame = spawnCFrame
end

-- Vô hiệu hóa hitbox/collisions của Entity để không cản trở raycast
for _, part in ipairs(s:GetDescendants()) do
	if part:IsA("BasePart") then
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		if part.Name ~= "Root" and part.Name ~= "HumanoidRootPart" then
			part.LocalTransparencyModifier = 0
		end
	end
end

local hitbox = entity:FindFirstChild("Hitbox", true) 
	or entity:FindFirstChild("HumanoidRootPart", true) 
	or entity:FindFirstChild("Root", true)

if hitbox and hitbox:IsA("BasePart") then
	hitbox.Size = Vector3.new(0.1, 0.1, 0.1)
end

